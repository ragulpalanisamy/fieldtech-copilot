# -----------------------------------------------------------------------------
# FieldTech Copilot — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate the secrets:
#   cp env.local.example .env.local
# DO NOT commit .env.local to Git (it is ignored by default).
# -----------------------------------------------------------------------------

# 1. Agora Core Credentials (from https://console.agora.io)
# Required: Project App ID (Client & Server)
NEXT_PUBLIC_AGORA_APP_ID=

# Required: Primary Certificate (Server-side only — never expose to client)
NEXT_AGORA_APP_CERTIFICATE=

# Required for Agora Conversational AI REST API agent invite (/join)
NEXT_AGORA_CUSTOMER_ID=
NEXT_AGORA_CUSTOMER_SECRET=

# 2. Public Reachability (for Agora Cloud to reach your Custom LLM SSE endpoint)
# Run `ngrok http 3000` during local dev, or use your production deployment URL (e.g. Vercel)
APP_PUBLIC_URL=https://your-tunnel.ngrok-free.app

# 3. Murf AI Falcon Streaming TTS (from https://murf.ai)
MURF_API_KEY=
MURF_VOICE_ID=Matthew
MURF_MODEL=FALCON
MURF_LOCALE=en-US

# 4. Custom LLM Provider (OpenAI or Gemini OpenAI-compatible Chat Completions)
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# For OpenAI: https://api.openai.com/v1/chat/completions
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Shared secret token Agora Cloud passes in the Authorization header to /api/chat/completions
CUSTOM_LLM_AUTH_TOKEN=fieldtech-secret-token
